// This Pine Script(TM) v6 source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
strategy(
     "5m Adaptive Intraday Strategy v5",
     overlay          = true,
     commission_value = 0.05,
     commission_type  = strategy.commission.percent,
     slippage         = 2,
     pyramiding       = 0,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     max_bars_back    = 5000,
     initial_capital  = 100000,
     currency         = currency.USD
     )

// ============================================================================
// SECTION 1 -- STRATEGY INPUTS
// ============================================================================

// --- Direction Control ---
i_enableLong  = input.bool(true,  "Enable Long Trades",  group = "Direction")
i_enableShort = input.bool(true,  "Enable Short Trades", group = "Direction")

// --- EMA Trend Filter ---
i_emaFastLen  = input.int(9,      "EMA Fast Length",     minval = 3,   maxval = 50,   group = "Trend Filter")
i_emaSlowLen  = input.int(21,     "EMA Slow Length",     minval = 10,  maxval = 100,  group = "Trend Filter")
i_emaTrendLen = input.int(50,     "EMA Trend Length",    minval = 20,  maxval = 200,  group = "Trend Filter")
i_useTrendFilter = input.bool(true, "Use EMA Trend Filter", group = "Trend Filter")

// --- VWAP ---
i_useVwap     = input.bool(true,  "Use VWAP Filter",     group = "VWAP")
i_useVwapSlope = input.bool(true, "Use VWAP Slope Filter", group = "VWAP",
                 tooltip = "Require VWAP to be sloping in trade direction")
i_vwapSlopeLen = input.int(5,     "VWAP Slope Lookback", minval = 2, maxval = 20, group = "VWAP")

// --- MACD (Fast settings for 5m) ---
i_macdFast    = input.int(5,      "MACD Fast Length",    minval = 2,   maxval = 20,   group = "MACD")
i_macdSlow    = input.int(13,     "MACD Slow Length",    minval = 5,   maxval = 50,   group = "MACD")
i_macdSignal  = input.int(1,      "MACD Signal Length",  minval = 1,   maxval = 15,   group = "MACD")
i_useHistMom  = input.bool(true,  "Require MACD Histogram Momentum", group = "MACD",
                tooltip = "Require histogram to be rising for longs, falling for shorts")

// --- RSI ---
i_rsiLen      = input.int(10,     "RSI Length",          minval = 2,   maxval = 30,   group = "RSI")
i_rsiOB       = input.int(70,     "RSI Overbought",     minval = 60,  maxval = 90,   group = "RSI")
i_rsiOS       = input.int(30,     "RSI Oversold",        minval = 10,  maxval = 40,   group = "RSI")
i_useRsiFilter = input.bool(true, "Use RSI Extreme Filter", group = "RSI",
                 tooltip = "Block new longs when RSI > OB, block new shorts when RSI < OS")
i_useRsiBias  = input.bool(true,  "Use RSI Directional Bias", group = "RSI",
                tooltip = "Require RSI > 50 for longs, RSI < 50 for shorts")

// --- Volume Filter ---
i_useVolFilter = input.bool(true, "Use Volume Filter",   group = "Volume")
i_volMultiple  = input.float(1.0, "Volume SMA Multiple", minval = 0.5, maxval = 3.0, step = 0.1, group = "Volume")
i_volLen       = input.int(20,    "Volume SMA Length",   minval = 5,   maxval = 50,   group = "Volume")

// --- ATR / Volatility ---
i_atrLen       = input.int(14,    "ATR Length",          minval = 5,   maxval = 30,   group = "Volatility")
i_useVolatilityFilter = input.bool(true, "Use Volatility Filter", group = "Volatility",
                        tooltip = "Block trades when ATR is extremely high")
i_atrHighMul   = input.float(2.5, "ATR High Threshold Multiple", minval = 1.5, maxval = 4.0, step = 0.5, group = "Volatility")

// --- Stop Loss ---
i_slType       = input.string("ATR", "Stop Loss Type", options = ["ATR", "Percent", "None"], group = "Stop Loss")
i_slAtrMul     = input.float(1.5,  "SL ATR Multiple",   minval = 0.5, maxval = 5.0,  step = 0.25, group = "Stop Loss")
i_slPct        = input.float(0.5,  "SL Percent",         minval = 0.1, maxval = 5.0,  step = 0.1,  group = "Stop Loss")

// --- Take Profit ---
i_tpType       = input.string("ATR", "Take Profit Type", options = ["ATR", "Percent", "None"], group = "Take Profit")
i_tpAtrMul     = input.float(2.5,  "TP ATR Multiple",   minval = 1.0, maxval = 10.0, step = 0.25, group = "Take Profit")
i_tpPct        = input.float(1.0,  "TP Percent",         minval = 0.2, maxval = 10.0, step = 0.1,  group = "Take Profit")

// --- Trailing Stop ---
i_useTrail     = input.bool(true,  "Use Trailing Stop",  group = "Trailing Stop")
i_trailAtrMul  = input.float(1.5,  "Trail ATR Multiple", minval = 0.5, maxval = 5.0,  step = 0.25, group = "Trailing Stop")
i_trailActMul  = input.float(1.0,  "Trail Activation ATR Multiple", minval = 0.5, maxval = 5.0, step = 0.25, group = "Trailing Stop")

// --- Break-Even ---
i_useBreakEven = input.bool(false, "Use Break-Even Stop", group = "Break-Even")
i_beAtrMul     = input.float(1.0,  "Break-Even Trigger ATR Multiple", minval = 0.5, maxval = 3.0, step = 0.25, group = "Break-Even")

// --- Session Filter ---
i_useSession   = input.bool(true,  "Use Session Filter", group = "Session")
i_sessStart    = input.session("0935-1555", "Trading Session", group = "Session",
                 tooltip = "Only trade within this session window (exchange timezone)")
i_closeEOD     = input.bool(true,  "Close All at Session End", group = "Session")
i_sessCloseTime = input.session("1555-1600", "EOD Close Window", group = "Session")

// --- Max Trades Per Day ---
i_useMaxTrades = input.bool(true,  "Limit Trades Per Day", group = "Trade Limits")
i_maxTrades    = input.int(6,      "Max Trades Per Day",   minval = 1, maxval = 20, group = "Trade Limits")

// --- Daily Loss Circuit Breaker ---
i_useDailyLossLimit = input.bool(true, "Use Daily Loss Limit", group = "Trade Limits")
i_dailyLossPct      = input.float(2.0, "Max Daily Loss %",    minval = 0.5, maxval = 10.0, step = 0.5, group = "Trade Limits",
                      tooltip = "Stop trading for the day after losing this % of starting equity")

// --- Signal Cooldown ---
i_useCooldown  = input.bool(true,  "Use Signal Cooldown After SL", group = "Trade Limits")
i_cooldownBars = input.int(6,      "Cooldown Bars After SL", minval = 1, maxval = 30, group = "Trade Limits",
                 tooltip = "Wait N bars after a stop-loss hit before taking new trades")

// --- Higher Timeframe Trend Filter ---
i_useHTF       = input.bool(true,  "Use Higher TF Trend Filter", group = "HTF Filter")
i_htfTF        = input.timeframe("60", "Higher Timeframe",       group = "HTF Filter")
i_htfEmaLen    = input.int(21,     "HTF EMA Length",             minval = 5, maxval = 100, group = "HTF Filter")

// --- ADX Regime Detection ---
i_useADX       = input.bool(true,  "Use ADX Trend Strength", group = "ADX")
i_adxLen       = input.int(14,     "ADX Length",             minval = 5,  maxval = 30,  group = "ADX")
i_adxThresh    = input.int(20,     "ADX Trending Threshold", minval = 10, maxval = 40,  group = "ADX")

// ============================================================================
// SECTION 2 -- INDICATOR CALCULATIONS
// ============================================================================

// --- EMAs ---
emaFast  = ta.ema(close, i_emaFastLen)
emaSlow  = ta.ema(close, i_emaSlowLen)
emaTrend = ta.ema(close, i_emaTrendLen)

emaBullish = emaFast > emaSlow
emaBearish = emaFast < emaSlow

emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

trendUp   = not i_useTrendFilter or close > emaTrend
trendDown = not i_useTrendFilter or close < emaTrend

// --- VWAP ---
vwapValue = ta.vwap(hlc3)
aboveVwap = close > vwapValue
belowVwap = close < vwapValue
vwapLongOk  = not i_useVwap or aboveVwap
vwapShortOk = not i_useVwap or belowVwap

// VWAP slope: is VWAP rising or falling over lookback?
vwapSlope     = vwapValue - vwapValue[i_vwapSlopeLen]
vwapSlopeUp   = not i_useVwapSlope or vwapSlope > 0
vwapSlopeDown = not i_useVwapSlope or vwapSlope < 0

// --- MACD ---
[macdLine, macdSignalLine, macdHist] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)
macdBullish = macdLine > macdSignalLine
macdBearish = macdLine < macdSignalLine
macdCrossUp   = ta.crossover(macdLine, macdSignalLine)
macdCrossDown = ta.crossunder(macdLine, macdSignalLine)

// Histogram momentum: rising = bullish acceleration, falling = bearish acceleration
macdHistRising  = macdHist > macdHist[1]
macdHistFalling = macdHist < macdHist[1]
histMomLong  = not i_useHistMom or macdHistRising
histMomShort = not i_useHistMom or macdHistFalling

// --- RSI ---
rsiValue = ta.rsi(close, i_rsiLen)
rsiNotOB = not i_useRsiFilter or rsiValue < i_rsiOB
rsiNotOS = not i_useRsiFilter or rsiValue > i_rsiOS

// RSI directional bias: confirms momentum is aligned with trade direction
rsiBiasLong  = not i_useRsiBias or rsiValue > 50
rsiBiasShort = not i_useRsiBias or rsiValue < 50

// --- Volume ---
volSma     = ta.sma(volume, i_volLen)
volAboveAvg = volume >= volSma * i_volMultiple
volumeOk   = not i_useVolFilter or volAboveAvg

// --- ATR ---
atrValue   = ta.atr(i_atrLen)
atrSma     = ta.sma(atrValue, 50)
volatilityOk = not i_useVolatilityFilter or atrValue < atrSma * i_atrHighMul

// --- ADX ---
adx_calc(len) =>
    up   = ta.change(high)
    down = -ta.change(low)
    plusDM  = na(up)   ? na : (up > down and up > 0   ? up   : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = ta.rma(ta.tr, len)
    plus  = 100 * ta.rma(plusDM, len)  / trueRange
    minus = 100 * ta.rma(minusDM, len) / trueRange
    dx = 100 * math.abs(plus - minus) / (plus + minus)
    adxVal = ta.rma(dx, len)
    [adxVal, plus, minus]

[adxValue, plusDI, minusDI] = adx_calc(i_adxLen)
isTrending = not i_useADX or adxValue > i_adxThresh

// --- Higher Timeframe EMA ---
htfEma = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, i_htfEmaLen),
         lookahead = barmerge.lookahead_off)

htfBullish = not i_useHTF or close > htfEma
htfBearish = not i_useHTF or close < htfEma

// ============================================================================
// SECTION 3 -- SESSION & RISK MANAGEMENT
// ============================================================================

inSession     = not i_useSession or not na(time(timeframe.period, i_sessStart))
inCloseWindow = i_closeEOD and not na(time(timeframe.period, i_sessCloseTime))

// --- Track trades per day ---
var int dailyTradeCount = 0
newDay = ta.change(time("D")) != 0
if newDay
    dailyTradeCount := 0

tradesAllowed = not i_useMaxTrades or dailyTradeCount < i_maxTrades

// --- Daily loss circuit breaker ---
var float dayStartEquity = strategy.equity
if newDay
    dayStartEquity := strategy.equity

dailyPnL    = strategy.equity - dayStartEquity
dailyPnLPct = dayStartEquity > 0 ? (dailyPnL / dayStartEquity) * 100 : 0.0
dailyLossOk = not i_useDailyLossLimit or dailyPnLPct > -i_dailyLossPct

// --- Signal cooldown after stop-loss ---
var int lastSLBar = 0

// Detect if last closed trade was a loss (SL hit)
wasLoss = strategy.closedtrades > 0 and
          strategy.closedtrades.profit(strategy.closedtrades - 1) < 0

if wasLoss and strategy.position_size == 0
    lastSLBar := bar_index

cooldownOk = not i_useCooldown or (bar_index - lastSLBar) >= i_cooldownBars

// ============================================================================
// SECTION 4 -- ENTRY CONDITIONS
// ============================================================================

// --- Core signal: MACD crossover as primary trigger ---
// EMA must already be aligned (trend established), MACD cross is the timing trigger
coreLong  = macdCrossUp and emaBullish
coreShort = macdCrossDown and emaBearish

// --- Alternative: EMA crossover when MACD is already aligned ---
altLong  = emaCrossUp and macdBullish
altShort = emaCrossDown and macdBearish

// Combined trigger
triggerLong  = coreLong or altLong
triggerShort = coreShort or altShort

// --- Full entry conditions ---
longCondition = i_enableLong
     and barstate.isconfirmed
     and inSession
     and tradesAllowed
     and dailyLossOk
     and cooldownOk
     and volatilityOk
     and triggerLong
     and histMomLong
     and trendUp
     and vwapLongOk
     and vwapSlopeUp
     and htfBullish
     and rsiNotOB
     and rsiBiasLong
     and volumeOk
     and isTrending
     and strategy.position_size <= 0

shortCondition = i_enableShort
     and barstate.isconfirmed
     and inSession
     and tradesAllowed
     and dailyLossOk
     and cooldownOk
     and volatilityOk
     and triggerShort
     and histMomShort
     and trendDown
     and vwapShortOk
     and vwapSlopeDown
     and htfBearish
     and rsiNotOS
     and rsiBiasShort
     and volumeOk
     and isTrending
     and strategy.position_size >= 0

// ============================================================================
// SECTION 5 -- STOP LOSS & TAKE PROFIT CALCULATION
// ============================================================================

calcSL(isLong) =>
    if i_slType == "ATR"
        isLong ? close - i_slAtrMul * atrValue : close + i_slAtrMul * atrValue
    else if i_slType == "Percent"
        isLong ? close * (1 - i_slPct / 100) : close * (1 + i_slPct / 100)
    else
        na

calcTP(isLong) =>
    if i_tpType == "ATR"
        isLong ? close + i_tpAtrMul * atrValue : close - i_tpAtrMul * atrValue
    else if i_tpType == "Percent"
        isLong ? close * (1 + i_tpPct / 100) : close * (1 - i_tpPct / 100)
    else
        na

// ============================================================================
// SECTION 6 -- TRADE EXECUTION
// ============================================================================

var float entryPrice = na
var float stopLevel  = na
var float tpLevel    = na

if longCondition
    sl = calcSL(true)
    tp = calcTP(true)
    entryPrice := close
    stopLevel  := sl
    tpLevel    := tp
    dailyTradeCount += 1

    strategy.entry("Long", strategy.long, comment = "L")

    trailPts    = i_useTrail ? i_trailAtrMul * atrValue / syminfo.mintick : na
    trailActPts = i_useTrail ? i_trailActMul * atrValue / syminfo.mintick : na

    strategy.exit("Long Exit", "Long",
                   stop          = sl,
                   limit         = tp,
                   trail_points  = trailActPts,
                   trail_offset  = trailPts,
                   comment_loss  = "L-SL",
                   comment_profit = "L-TP")

if shortCondition
    sl = calcSL(false)
    tp = calcTP(false)
    entryPrice := close
    stopLevel  := sl
    tpLevel    := tp
    dailyTradeCount += 1

    strategy.entry("Short", strategy.short, comment = "S")

    trailPts    = i_useTrail ? i_trailAtrMul * atrValue / syminfo.mintick : na
    trailActPts = i_useTrail ? i_trailActMul * atrValue / syminfo.mintick : na

    strategy.exit("Short Exit", "Short",
                   stop          = sl,
                   limit         = tp,
                   trail_points  = trailActPts,
                   trail_offset  = trailPts,
                   comment_loss  = "S-SL",
                   comment_profit = "S-TP")

// --- Break-Even Logic ---
if i_useBreakEven and strategy.position_size != 0
    beDistance = i_beAtrMul * atrValue
    if strategy.position_size > 0 and not na(entryPrice)
        if close >= entryPrice + beDistance
            strategy.exit("Long BE", "Long", stop = entryPrice, comment = "L-BE")
    if strategy.position_size < 0 and not na(entryPrice)
        if close <= entryPrice - beDistance
            strategy.exit("Short BE", "Short", stop = entryPrice, comment = "S-BE")

// --- Opposite signal exit: close on confirmed reversal ---
revLong  = macdCrossUp and emaBullish and macdHistRising
revShort = macdCrossDown and emaBearish and macdHistFalling

if strategy.position_size > 0 and revShort and barstate.isconfirmed
    strategy.close("Long", comment = "L-Rev")

if strategy.position_size < 0 and revLong and barstate.isconfirmed
    strategy.close("Short", comment = "S-Rev")

// --- End of Day Close ---
if inCloseWindow and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// --- Reset tracking when flat ---
if strategy.position_size == 0
    entryPrice := na
    stopLevel  := na
    tpLevel    := na

// ============================================================================
// SECTION 7 -- VISUAL OVERLAYS
// ============================================================================

// EMAs
plot(emaFast,   "EMA Fast",   color.new(color.blue, 30),   1)
plot(emaSlow,   "EMA Slow",   color.new(color.orange, 30), 1)
plot(emaTrend,  "EMA Trend",  color.new(color.gray, 50),   2)

// VWAP
plot(i_useVwap ? vwapValue : na, "VWAP", color.new(color.purple, 20), 2, plot.style_stepline)

// HTF EMA
plot(i_useHTF ? htfEma : na, "HTF EMA", color.new(color.yellow, 40), 2, plot.style_cross)

// Entry signals
plotshape(longCondition,  "Long Signal",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(shortCondition, "Short Signal", shape.triangledown,  location.abovebar, color.new(color.red, 0),   size = size.small)

// Session background
bgcolor(inSession ? color.new(color.blue, 97) : color.new(color.gray, 98), title = "Session BG")
bgcolor(inCloseWindow ? color.new(color.red, 90) : na, title = "EOD Close BG")

// Daily loss limit warning
bgcolor(not dailyLossOk ? color.new(color.red, 85) : na, title = "Daily Loss Limit BG")

// ============================================================================
// SECTION 8 -- DASHBOARD
// ============================================================================

var table dash = table.new(position.top_right, 2, 12,
                 bgcolor = color.new(color.black, 20),
                 border_width = 1,
                 border_color = color.gray,
                 frame_width  = 2,
                 frame_color  = color.white)

totalTrades = strategy.closedtrades
wins = strategy.wintrades
winRate = totalTrades > 0 ? (wins / totalTrades) * 100 : 0.0
pf = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0

trendStr = emaBullish and aboveVwap ? "BULLISH" :
           emaBearish and belowVwap ? "BEARISH" : "MIXED"
trendColor = trendStr == "BULLISH" ? color.green :
             trendStr == "BEARISH" ? color.red : color.gray

adxStr = adxValue > i_adxThresh ? "TREND (" + str.tostring(adxValue, "#.#") + ")" :
         "RANGE (" + str.tostring(adxValue, "#.#") + ")"
adxColor = adxValue > i_adxThresh ? color.green : color.orange

sigStr = longCondition ? "LONG" : shortCondition ? "SHORT" : "FLAT"
sigColor = longCondition ? color.green : shortCondition ? color.red : color.gray

if barstate.islast
    table.cell(dash, 0, 0,  "Metric",       text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0,  "Value",         text_color = color.white,  text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 1,  "Trend",         text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1,  trendStr,        text_color = trendColor,   text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 2,  "Regime",        text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2,  adxStr,          text_color = adxColor,     text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 3,  "Signal",        text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3,  sigStr,          text_color = sigColor,     text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 4,  "RSI",           text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4,  str.tostring(rsiValue, "#.#"),
               text_color = rsiValue > i_rsiOB ? color.red : rsiValue < i_rsiOS ? color.green : color.white,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 5,  "MACD Hist",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5,  str.tostring(macdHist, "#.####"),
               text_color = macdHist > 0 ? color.green : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 6,  "Daily Trades",  text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6,  str.tostring(dailyTradeCount) + "/" + str.tostring(i_maxTrades),
               text_color = dailyTradeCount >= i_maxTrades ? color.red : color.white,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 7,  "Daily P&L",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7,  str.tostring(dailyPnLPct, "#.##") + "%",
               text_color = dailyPnLPct > 0 ? color.green : dailyPnLPct > -i_dailyLossPct ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 8,  "Win Rate",      text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 8,  str.tostring(winRate, "#.#") + "% (" + str.tostring(totalTrades) + ")",
               text_color = winRate >= 50 ? color.green : winRate >= 40 ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 9,  "Profit Factor", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9,  str.tostring(pf, "#.##"),
               text_color = pf > 1.5 ? color.green : pf > 1.0 ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 10, "Net P&L",       text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 10, str.tostring(strategy.netprofit, "#.##"),
               text_color = strategy.netprofit > 0 ? color.green : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 11, "Max DD",        text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 11, str.tostring(strategy.max_drawdown, "#.##"),
               text_color = strategy.max_drawdown > strategy.initial_capital * 0.15 ? color.red :
                           strategy.max_drawdown > strategy.initial_capital * 0.10 ? color.orange : color.green,
               text_size = size.small, text_halign = text.align_right)

// ============================================================================
// SECTION 9 -- ALERT CONDITIONS
// ============================================================================

alertcondition(longCondition,  title = "Long Entry",
     message = "5m Strategy: LONG | {{ticker}} @ {{close}} | RSI: " + str.tostring(rsiValue, "#.#") + " | ADX: " + str.tostring(adxValue, "#.#"))

alertcondition(shortCondition, title = "Short Entry",
     message = "5m Strategy: SHORT | {{ticker}} @ {{close}} | RSI: " + str.tostring(rsiValue, "#.#") + " | ADX: " + str.tostring(adxValue, "#.#"))

alertcondition(inCloseWindow and strategy.position_size != 0, title = "EOD Close",
     message = "5m Strategy: EOD Close | {{ticker}} @ {{close}}")

alertcondition(not dailyLossOk, title = "Daily Loss Limit Hit",
     message = "5m Strategy: Daily loss limit reached | {{ticker}} | P&L: " + str.tostring(dailyPnLPct, "#.##") + "%")
