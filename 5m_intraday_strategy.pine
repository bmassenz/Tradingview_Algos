// This Pine Script(TM) v6 source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
strategy(
     "5m Adaptive Intraday Strategy v6",
     overlay          = true,
     commission_value = 0.05,
     commission_type  = strategy.commission.percent,
     slippage         = 2,
     pyramiding       = 0,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     calc_on_every_tick = false,
     process_orders_on_close = false,
     max_bars_back    = 5000,
     initial_capital  = 100000,
     currency         = currency.USD
     )

// ============================================================================
// SECTION 1 -- INPUTS
// ============================================================================

// --- Direction ---
i_enableLong  = input.bool(true,  "Enable Long Trades",  group = "Direction")
i_enableShort = input.bool(true,  "Enable Short Trades", group = "Direction")

// --- EMA ---
i_emaFastLen  = input.int(9,      "EMA Fast Length",     minval = 3,   maxval = 50,   group = "EMA")
i_emaSlowLen  = input.int(21,     "EMA Slow Length",     minval = 10,  maxval = 100,  group = "EMA")
i_emaTrendLen = input.int(50,     "EMA Trend Length",    minval = 20,  maxval = 200,  group = "EMA")

// --- VWAP ---
i_useVwap      = input.bool(true,  "Use VWAP Filter",     group = "VWAP")

// --- MACD ---
i_macdFast    = input.int(5,      "MACD Fast",           minval = 2,   maxval = 20,   group = "MACD")
i_macdSlow    = input.int(13,     "MACD Slow",           minval = 5,   maxval = 50,   group = "MACD")
i_macdSignal  = input.int(1,      "MACD Signal",         minval = 1,   maxval = 15,   group = "MACD")

// --- RSI ---
i_rsiLen      = input.int(10,     "RSI Length",          minval = 2,   maxval = 30,   group = "RSI")
i_rsiOB       = input.int(70,     "RSI Overbought",     minval = 60,  maxval = 90,   group = "RSI")
i_rsiOS       = input.int(30,     "RSI Oversold",        minval = 10,  maxval = 40,   group = "RSI")

// --- Volume ---
i_useVolFilter = input.bool(true, "Use Volume Filter",   group = "Volume")
i_volMultiple  = input.float(0.8, "Volume SMA Multiple", minval = 0.3, maxval = 3.0, step = 0.1, group = "Volume")
i_volLen       = input.int(20,    "Volume SMA Length",   minval = 5,   maxval = 50,   group = "Volume")

// --- ATR / Volatility ---
i_atrLen       = input.int(14,    "ATR Length",          minval = 5,   maxval = 30,   group = "Volatility")
i_useVolatilityFilter = input.bool(true, "Block Extreme Volatility", group = "Volatility")
i_atrHighMul   = input.float(2.5, "ATR Extreme Multiple", minval = 1.5, maxval = 4.0, step = 0.5, group = "Volatility")

// --- Confluence Scoring ---
i_minScore    = input.int(4,      "Min Confluence Score (of 7)", minval = 2, maxval = 7, group = "Confluence",
                tooltip = "Minimum points required from: EMA trend, VWAP side, HTF trend, RSI bias, MACD hist, ADX trending, Volume")

// --- Signal Persistence ---
i_persistBars = input.int(3,      "Signal Persistence (bars)", minval = 1, maxval = 8, group = "Signal",
                tooltip = "MACD/EMA crossover stays valid for N bars")

// --- Stop Loss ---
i_slAtrMul    = input.float(1.5,  "SL ATR Multiple",    minval = 0.5, maxval = 5.0,  step = 0.25, group = "Stop Loss")

// --- Take Profit ---
i_tpAtrMul    = input.float(2.5,  "TP ATR Multiple",    minval = 1.0, maxval = 10.0, step = 0.25, group = "Take Profit")

// --- Partial Profit ---
i_usePartial  = input.bool(true,  "Use Partial Profit Taking", group = "Partial TP")
i_partialMul  = input.float(1.0,  "Partial TP ATR Multiple",   minval = 0.5, maxval = 3.0, step = 0.25, group = "Partial TP")
i_partialPct  = input.float(50,   "Partial Close %",           minval = 25,  maxval = 75,  step = 25,   group = "Partial TP")

// --- Trailing Stop ---
i_useTrail    = input.bool(true,  "Use Trailing Stop",  group = "Trailing Stop")
i_trailAtrMul = input.float(1.0,  "Trail ATR Multiple", minval = 0.5, maxval = 5.0,  step = 0.25, group = "Trailing Stop")
i_trailActMul = input.float(1.5,  "Trail Activation ATR Multiple", minval = 0.5, maxval = 5.0, step = 0.25, group = "Trailing Stop")

// --- Stale Trade Exit ---
i_useStaleExit = input.bool(true, "Use Stale Trade Exit", group = "Stale Exit")
i_staleBars    = input.int(20,    "Close After N Bars if < 0.5 ATR Profit", minval = 5, maxval = 60, group = "Stale Exit")

// --- Session ---
i_useSession   = input.bool(true,  "Use Session Filter", group = "Session")
i_sessStart    = input.session("0935-1555", "Trading Session", group = "Session")
i_closeEOD     = input.bool(true,  "Close All at Session End", group = "Session")
i_sessCloseTime = input.session("1555-1600", "EOD Close Window", group = "Session")

// --- Trade Limits ---
i_useMaxTrades = input.bool(true,  "Limit Trades Per Day", group = "Trade Limits")
i_maxTrades    = input.int(8,      "Max Trades Per Day",   minval = 1, maxval = 20, group = "Trade Limits")
i_useDailyLoss = input.bool(true,  "Use Daily Loss Limit", group = "Trade Limits")
i_dailyLossPct = input.float(2.0,  "Max Daily Loss %",     minval = 0.5, maxval = 10.0, step = 0.5, group = "Trade Limits")

// --- Cooldown ---
i_useCooldown  = input.bool(true,  "Use Cooldown After SL",  group = "Trade Limits")
i_cooldownBars = input.int(4,      "Cooldown Bars After SL", minval = 1, maxval = 20, group = "Trade Limits")

// --- HTF Filter ---
i_useHTF       = input.bool(true,  "Use HTF Trend Filter",  group = "HTF Filter")
i_htfTF        = input.timeframe("60", "Higher Timeframe",  group = "HTF Filter")
i_htfEmaLen    = input.int(21,     "HTF EMA Length",         minval = 5, maxval = 100, group = "HTF Filter")

// --- ADX ---
i_adxLen       = input.int(14,     "ADX Length",             minval = 5,  maxval = 30,  group = "ADX")
i_adxThresh    = input.int(20,     "ADX Trending Threshold", minval = 10, maxval = 40,  group = "ADX")

// --- Regime Adaptation ---
i_useRegimeAdapt = input.bool(true, "Adapt SL/TP to Regime", group = "Regime",
                   tooltip = "Widen targets in trends, tighten in ranges")
i_trendSlBonus   = input.float(0.5, "Trend SL Bonus ATR",   minval = 0, maxval = 2.0, step = 0.25, group = "Regime")
i_trendTpBonus   = input.float(1.0, "Trend TP Bonus ATR",   minval = 0, maxval = 3.0, step = 0.25, group = "Regime")

// --- Equity Curve Position Sizing ---
i_useEquityCurve = input.bool(true, "Reduce Size in Drawdown", group = "Risk")
i_ddThreshold    = input.float(5.0, "Drawdown Threshold %",   minval = 1, maxval = 20, step = 1, group = "Risk")
i_ddReduction    = input.float(50,  "Position Size Reduction %", minval = 10, maxval = 90, step = 10, group = "Risk")

// ============================================================================
// SECTION 2 -- INDICATORS
// ============================================================================

// --- EMAs ---
emaFast  = ta.ema(close, i_emaFastLen)
emaSlow  = ta.ema(close, i_emaSlowLen)
emaTrend = ta.ema(close, i_emaTrendLen)

emaBullish = emaFast > emaSlow
emaBearish = emaFast < emaSlow
emaCrossUp   = ta.crossover(emaFast, emaSlow)
emaCrossDown = ta.crossunder(emaFast, emaSlow)

// --- VWAP ---
vwapValue = ta.vwap(hlc3)
aboveVwap = close > vwapValue
belowVwap = close < vwapValue

// --- MACD ---
[macdLine, macdSignalLine, macdHist] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)
macdBullish = macdLine > macdSignalLine
macdBearish = macdLine < macdSignalLine
macdCrossUp   = ta.crossover(macdLine, macdSignalLine)
macdCrossDown = ta.crossunder(macdLine, macdSignalLine)
macdHistRising  = macdHist > macdHist[1]
macdHistFalling = macdHist < macdHist[1]

// --- RSI ---
rsiValue = ta.rsi(close, i_rsiLen)

// --- Volume ---
volSma     = ta.sma(volume, i_volLen)
volAboveAvg = volume >= volSma * i_volMultiple

// --- ATR ---
atrValue = ta.atr(i_atrLen)
atrSma   = ta.sma(atrValue, 50)
volatilityOk = not i_useVolatilityFilter or atrValue < atrSma * i_atrHighMul

// --- ADX ---
adx_calc(len) =>
    up   = ta.change(high)
    down = -ta.change(low)
    plusDM  = na(up)   ? na : (up > down and up > 0   ? up   : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = ta.rma(ta.tr, len)
    plus  = 100 * ta.rma(plusDM, len)  / trueRange
    minus = 100 * ta.rma(minusDM, len) / trueRange
    dx = 100 * math.abs(plus - minus) / (plus + minus)
    adxVal = ta.rma(dx, len)
    adxVal

adxValue = adx_calc(i_adxLen)
isTrending = adxValue > i_adxThresh

// --- HTF EMA (only fetch when enabled to save computation) ---
htfEma = i_useHTF ? request.security(syminfo.tickerid, i_htfTF, ta.ema(close, i_htfEmaLen),
         lookahead = barmerge.lookahead_off) : emaTrend
htfBullish = close > htfEma
htfBearish = close < htfEma

// ============================================================================
// SECTION 3 -- SIGNAL PERSISTENCE
// ============================================================================

// Keep crossover signals alive for N bars so they can combine with filters
var int macdBullAge = 999
var int macdBearAge = 999
var int emaBullAge  = 999
var int emaBearAge  = 999

macdBullAge := macdCrossUp   ? 0 : macdBullAge + 1
macdBearAge := macdCrossDown ? 0 : macdBearAge + 1
emaBullAge  := emaCrossUp    ? 0 : emaBullAge + 1
emaBearAge  := emaCrossDown  ? 0 : emaBearAge + 1

// Signal is valid if crossover happened within persistence window
macdBullPersist = macdBullAge <= i_persistBars and macdBullish
macdBearPersist = macdBearAge <= i_persistBars and macdBearish
emaBullPersist  = emaBullAge  <= i_persistBars and emaBullish
emaBearPersist  = emaBearAge  <= i_persistBars and emaBearish

// Core trigger: either crossover must be fresh AND the other must confirm direction
triggerLong  = (macdBullPersist and emaBullish) or (emaBullPersist and macdBullish)
triggerShort = (macdBearPersist and emaBearish) or (emaBearPersist and macdBearish)

// ============================================================================
// SECTION 4 -- CONFLUENCE SCORING (soft filters replace hard gates)
// ============================================================================

// Each factor adds 1 point. Minimum score required to enter.
// This replaces 7 hard-gate filters with a flexible scoring system.

longScore = (close > emaTrend       ? 1 : 0) +   // EMA trend
            (aboveVwap              ? 1 : 0) +   // VWAP side
            (htfBullish             ? 1 : 0) +   // HTF trend
            (rsiValue > 50          ? 1 : 0) +   // RSI bias
            (macdHistRising         ? 1 : 0) +   // MACD momentum
            (isTrending             ? 1 : 0) +   // ADX strength
            (volAboveAvg            ? 1 : 0)     // Volume

shortScore = (close < emaTrend      ? 1 : 0) +
             (belowVwap             ? 1 : 0) +
             (htfBearish            ? 1 : 0) +
             (rsiValue < 50         ? 1 : 0) +
             (macdHistFalling       ? 1 : 0) +
             (isTrending            ? 1 : 0) +
             (volAboveAvg           ? 1 : 0)

confluenceLong  = longScore  >= i_minScore
confluenceShort = shortScore >= i_minScore

// ============================================================================
// SECTION 5 -- SESSION & RISK GATES (hard filters -- kept minimal)
// ============================================================================

inSession     = not i_useSession or not na(time(timeframe.period, i_sessStart))
inCloseWindow = i_closeEOD and not na(time(timeframe.period, i_sessCloseTime))

// --- Daily trade count ---
var int dailyTradeCount = 0
newDay = ta.change(time("D")) != 0
if newDay
    dailyTradeCount := 0
tradesAllowed = not i_useMaxTrades or dailyTradeCount < i_maxTrades

// --- Daily loss limit ---
var float dayStartEquity = strategy.equity
if newDay
    dayStartEquity := strategy.equity
dailyPnL    = strategy.equity - dayStartEquity
dailyPnLPct = dayStartEquity > 0 ? (dailyPnL / dayStartEquity) * 100 : 0.0
dailyLossOk = not i_useDailyLoss or dailyPnLPct > -i_dailyLossPct

// --- Cooldown after SL ---
var int lastSLBar = 0
wasLoss = strategy.closedtrades > 0 and
          strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
if wasLoss and strategy.position_size == 0 and strategy.closedtrades > strategy.closedtrades[1]
    lastSLBar := bar_index
cooldownOk = not i_useCooldown or (bar_index - lastSLBar) >= i_cooldownBars

// --- RSI extreme block (hard gate -- never buy at RSI 80+, never short at RSI 20-) ---
rsiNotExtreme_Long  = rsiValue < i_rsiOB
rsiNotExtreme_Short = rsiValue > i_rsiOS

// --- Equity curve position sizing ---
var float peakEquity = strategy.initial_capital
if strategy.equity > peakEquity
    peakEquity := strategy.equity
equityDD = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100 : 0.0
inDrawdown = i_useEquityCurve and equityDD > i_ddThreshold
positionPct = inDrawdown ? (100.0 - i_ddReduction) : 100.0

// ============================================================================
// SECTION 6 -- ENTRY CONDITIONS
// ============================================================================

longCondition = i_enableLong
     and barstate.isconfirmed
     and inSession
     and tradesAllowed
     and dailyLossOk
     and cooldownOk
     and volatilityOk
     and triggerLong
     and confluenceLong
     and rsiNotExtreme_Long
     and strategy.position_size <= 0

shortCondition = i_enableShort
     and barstate.isconfirmed
     and inSession
     and tradesAllowed
     and dailyLossOk
     and cooldownOk
     and volatilityOk
     and triggerShort
     and confluenceShort
     and rsiNotExtreme_Short
     and strategy.position_size >= 0

// ============================================================================
// SECTION 7 -- REGIME-ADAPTIVE SL/TP
// ============================================================================

slMul = i_slAtrMul + (i_useRegimeAdapt and isTrending ? i_trendSlBonus : 0)
tpMul = i_tpAtrMul + (i_useRegimeAdapt and isTrending ? i_trendTpBonus : 0)

// ============================================================================
// SECTION 8 -- TRADE EXECUTION
// ============================================================================

var float entryPrice  = na
var int   entryBar    = na
var float entryATR    = na

if longCondition
    sl = close - slMul * atrValue
    tp = close + tpMul * atrValue
    entryPrice := close
    entryBar   := bar_index
    entryATR   := atrValue
    dailyTradeCount += 1

    qty = strategy.equity * (positionPct / 100) / close
    strategy.entry("Long", strategy.long, qty = qty, comment = "L[" + str.tostring(longScore) + "]")

    // Partial TP
    if i_usePartial
        partialTP = close + i_partialMul * atrValue
        strategy.exit("Long Partial", "Long",
                       qty_percent = i_partialPct,
                       limit       = partialTP,
                       comment     = "L-P")

    // Main exit with SL, TP, and optional trailing
    trailPts    = i_useTrail ? i_trailAtrMul * atrValue / syminfo.mintick : na
    trailActPts = i_useTrail ? i_trailActMul * atrValue / syminfo.mintick : na

    strategy.exit("Long Exit", "Long",
                   stop          = sl,
                   limit         = tp,
                   trail_points  = trailActPts,
                   trail_offset  = trailPts,
                   comment_loss  = "L-SL",
                   comment_profit = "L-TP")

if shortCondition
    sl = close + slMul * atrValue
    tp = close - tpMul * atrValue
    entryPrice := close
    entryBar   := bar_index
    entryATR   := atrValue
    dailyTradeCount += 1

    qty = strategy.equity * (positionPct / 100) / close
    strategy.entry("Short", strategy.short, qty = qty, comment = "S[" + str.tostring(shortScore) + "]")

    if i_usePartial
        partialTP = close - i_partialMul * atrValue
        strategy.exit("Short Partial", "Short",
                       qty_percent = i_partialPct,
                       limit       = partialTP,
                       comment     = "S-P")

    trailPts    = i_useTrail ? i_trailAtrMul * atrValue / syminfo.mintick : na
    trailActPts = i_useTrail ? i_trailActMul * atrValue / syminfo.mintick : na

    strategy.exit("Short Exit", "Short",
                   stop          = sl,
                   limit         = tp,
                   trail_points  = trailActPts,
                   trail_offset  = trailPts,
                   comment_loss  = "S-SL",
                   comment_profit = "S-TP")

// --- Stale trade exit: close trades going nowhere ---
if i_useStaleExit and strategy.position_size != 0 and not na(entryBar) and not na(entryATR)
    barsHeld = bar_index - entryBar
    if barsHeld >= i_staleBars
        unrealizedMove = math.abs(close - entryPrice)
        if unrealizedMove < 0.5 * entryATR
            strategy.close_all(comment = "Stale")

// --- Opposite signal exit ---
if strategy.position_size > 0 and triggerShort and confluenceShort and barstate.isconfirmed
    strategy.close("Long", comment = "L-Rev")

if strategy.position_size < 0 and triggerLong and confluenceLong and barstate.isconfirmed
    strategy.close("Short", comment = "S-Rev")

// --- EOD close ---
if inCloseWindow and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// --- Reset ---
if strategy.position_size == 0
    entryPrice := na
    entryBar   := na
    entryATR   := na

// ============================================================================
// SECTION 9 -- VISUALS
// ============================================================================

plot(emaFast,  "EMA Fast",  color.new(color.blue, 30),   1)
plot(emaSlow,  "EMA Slow",  color.new(color.orange, 30), 1)
plot(emaTrend, "EMA Trend", color.new(color.gray, 50),   2)

plot(i_useVwap ? vwapValue : na, "VWAP", color.new(color.purple, 20), 2, plot.style_stepline)
plot(i_useHTF  ? htfEma    : na, "HTF EMA", color.new(color.yellow, 40), 2, plot.style_cross)

plotshape(longCondition,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(shortCondition, "Short", shape.triangledown,  location.abovebar, color.new(color.red, 0),   size = size.small)

bgcolor(inSession ? color.new(color.blue, 97) : color.new(color.gray, 98), title = "Session")
bgcolor(inCloseWindow ? color.new(color.red, 90) : na, title = "EOD")
bgcolor(not dailyLossOk ? color.new(color.red, 85) : na, title = "Loss Limit")

// Score bar color (more green = more confluence)
barcolor(longCondition ? color.lime : shortCondition ? color.fuchsia : na)

// ============================================================================
// SECTION 10 -- DASHBOARD
// ============================================================================

var table dash = table.new(position.top_right, 2, 13,
                 bgcolor = color.new(color.black, 20),
                 border_width = 1,
                 border_color = color.gray,
                 frame_width  = 2,
                 frame_color  = color.white)

totalTrades = strategy.closedtrades
wins = strategy.wintrades
winRate = totalTrades > 0 ? (wins / totalTrades) * 100 : 0.0
pf = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0

regimeStr = isTrending ? "TREND" : "RANGE"
regimeColor = isTrending ? color.green : color.orange

trendStr = emaBullish and aboveVwap ? "BULL" :
           emaBearish and belowVwap ? "BEAR" : "MIXED"
trendColor = trendStr == "BULL" ? color.green :
             trendStr == "BEAR" ? color.red : color.gray

if barstate.islast
    table.cell(dash, 0, 0,  "Metric",       text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0,  "Value",         text_color = color.white,  text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 1,  "Trend",         text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1,  trendStr,        text_color = trendColor,   text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 2,  "Regime",        text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2,  regimeStr + " (" + str.tostring(adxValue, "#.#") + ")",
               text_color = regimeColor, text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 3,  "Long Score",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3,  str.tostring(longScore) + "/7",
               text_color = longScore >= i_minScore ? color.green : color.gray,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 4,  "Short Score",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4,  str.tostring(shortScore) + "/7",
               text_color = shortScore >= i_minScore ? color.red : color.gray,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 5,  "RSI",           text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5,  str.tostring(rsiValue, "#.#"),
               text_color = rsiValue > i_rsiOB ? color.red : rsiValue < i_rsiOS ? color.green : color.white,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 6,  "MACD Hist",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6,  str.tostring(macdHist, "#.####"),
               text_color = macdHist > 0 ? color.green : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 7,  "Daily Trades",  text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7,  str.tostring(dailyTradeCount) + "/" + str.tostring(i_maxTrades),
               text_color = dailyTradeCount >= i_maxTrades ? color.red : color.white,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 8,  "Daily P&L",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 8,  str.tostring(dailyPnLPct, "#.##") + "%",
               text_color = dailyPnLPct > 0 ? color.green : dailyPnLPct > -i_dailyLossPct ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 9,  "Win Rate",      text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9,  str.tostring(winRate, "#.#") + "% (" + str.tostring(totalTrades) + ")",
               text_color = winRate >= 50 ? color.green : winRate >= 40 ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 10, "Profit Factor", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 10, str.tostring(pf, "#.##"),
               text_color = pf > 1.5 ? color.green : pf > 1.0 ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 11, "Net P&L",       text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 11, str.tostring(strategy.netprofit, "#.##"),
               text_color = strategy.netprofit > 0 ? color.green : color.red,
               text_size = size.small, text_halign = text.align_right)

    table.cell(dash, 0, 12, "Equity DD%",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 12, str.tostring(equityDD, "#.##") + "%",
               text_color = equityDD > 10 ? color.red : equityDD > 5 ? color.orange : color.green,
               text_size = size.small, text_halign = text.align_right)

// ============================================================================
// SECTION 11 -- ALERTS
// ============================================================================

if longCondition
    alert("5m v6: LONG | " + syminfo.ticker + " @ " + str.tostring(close) +
          " | Score: " + str.tostring(longScore) + "/7" +
          " | RSI: " + str.tostring(rsiValue, "#.#") +
          " | ADX: " + str.tostring(adxValue, "#.#"),
          alert.freq_once_per_bar_close)

if shortCondition
    alert("5m v6: SHORT | " + syminfo.ticker + " @ " + str.tostring(close) +
          " | Score: " + str.tostring(shortScore) + "/7" +
          " | RSI: " + str.tostring(rsiValue, "#.#") +
          " | ADX: " + str.tostring(adxValue, "#.#"),
          alert.freq_once_per_bar_close)

if inCloseWindow and strategy.position_size != 0
    alert("5m v6: EOD Close | " + syminfo.ticker + " @ " + str.tostring(close),
          alert.freq_once_per_bar_close)

if not dailyLossOk and dailyLossOk[1]
    alert("5m v6: Daily loss limit | " + syminfo.ticker +
          " | P&L: " + str.tostring(dailyPnLPct, "#.##") + "%",
          alert.freq_once_per_bar_close)
