// This Pine Script(TM) v6 source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=6
strategy(
     "5m Pullback Continuation v10",
     overlay                 = true,
     commission_value        = 0.05,
     commission_type         = strategy.commission.percent,
     slippage                = 2,
     pyramiding              = 0,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     calc_on_every_tick      = false,
     process_orders_on_close = false,
     max_bars_back           = 5000,
     initial_capital         = 100000,
     currency                = currency.USD
)

// ============================================================================
// SECTION 1 -- INPUTS
// ============================================================================

i_enableLong  = input.bool(true,  "Enable Long Trades",  group = "Direction")
i_enableShort = input.bool(false, "Enable Short Trades", group = "Direction")

// --- EMA ---
i_emaFastLen  = input.int(9,      "EMA Fast Length",     minval = 3,   maxval = 50,   group = "EMA")
i_emaSlowLen  = input.int(21,     "EMA Slow Length",     minval = 10,  maxval = 100,  group = "EMA")

// --- VWAP ---
i_useVwap     = input.bool(true,  "Use VWAP Trend Filter", group = "VWAP")

// --- RSI ---
i_rsiLen      = input.int(10,     "RSI Length",          minval = 2,   maxval = 30,   group = "RSI")
i_rsiOB       = input.int(75,     "RSI Overbought",      minval = 60,  maxval = 90,   group = "RSI")
i_rsiOS       = input.int(25,     "RSI Oversold",        minval = 10,  maxval = 40,   group = "RSI")

// --- Volume ---
i_useVolFilter = input.bool(true, "Use Volume Filter",   group = "Volume")
i_volMultiple  = input.float(1.5, "Volume SMA Multiple", minval = 0.3, maxval = 3.0, step = 0.1, group = "Volume")
i_volLen       = input.int(20,    "Volume SMA Length",   minval = 5,   maxval = 50,   group = "Volume")

// --- ATR ---
i_atrLen       = input.int(14,    "ATR Length",          minval = 5,   maxval = 30,   group = "ATR")

// --- Pullback Entry ---
i_pullbackBars = input.int(5,     "Pullback Lookback Bars", minval = 1, maxval = 10, group = "Pullback Entry",
                 tooltip = "Number of bars to look back for pullback to SLOW EMA")
i_requireBounce = input.bool(true, "Require Bounce Candle", group = "Pullback Entry",
                  tooltip = "Current bar must close above EMA fast for longs (below for shorts)")
i_minBarsBetween = input.int(60,  "Min Bars Between Any Trade", minval = 3, maxval = 200, group = "Pullback Entry",
                   tooltip = "Minimum spacing between trades to prevent overtrading")

// --- Stop Loss ---
i_slAtrMul    = input.float(2.5,  "SL ATR Multiple",     minval = 0.5, maxval = 5.0,  step = 0.25, group = "Stop Loss")

// --- Take Profit ---
i_tpAtrMul    = input.float(4.0,  "TP ATR Multiple",     minval = 1.0, maxval = 10.0, step = 0.25, group = "Take Profit")

// --- Trailing Stop ---
i_useTrail    = input.bool(false, "Use Trailing Stop",  group = "Trailing Stop")
i_trailAtrMul = input.float(1.5,  "Trail ATR Multiple", minval = 0.5, maxval = 5.0,  step = 0.25, group = "Trailing Stop")
i_trailActMul = input.float(1.5,  "Trail Activation ATR Multiple", minval = 0.5, maxval = 5.0, step = 0.25, group = "Trailing Stop")

// --- Stale Trade Exit ---
i_useStaleExit = input.bool(true, "Use Stale Trade Exit", group = "Stale Exit")
i_staleBars    = input.int(30,    "Close After N Bars if < 0.5 ATR Profit", minval = 5, maxval = 60, group = "Stale Exit")

// --- Position Sizing ---
i_qtyMode     = input.string("Fixed Dollar", "Position Size Mode",
                options = ["Fixed Dollar", "Risk Percent"], group = "Position Sizing")
i_fixedDollar = input.float(20000, "Fixed Dollar Amount", minval = 1000, maxval = 500000, step = 1000, group = "Position Sizing",
                tooltip = "Max dollar value per trade (caps commission impact)")
i_riskPct     = input.float(1.0,  "Risk % Per Trade (Risk Mode)", minval = 0.25, maxval = 3.0, step = 0.25, group = "Position Sizing")
i_maxQtyDollar = input.float(50000, "Max Position Dollar Cap", minval = 5000, maxval = 500000, step = 5000, group = "Position Sizing",
                 tooltip = "Hard cap on position size regardless of mode")

// --- Session ---
i_useSession       = input.bool(true,  "Use Session Filter", group = "Session")
i_sessionTZ        = input.string("America/New_York", "Session Time Zone", options = ["America/New_York"], group = "Session")
i_sessStartHour    = input.int(10,  "Session Start Hour",   minval = 0, maxval = 23, group = "Session")
i_sessStartMinute  = input.int(0,   "Session Start Minute", minval = 0, maxval = 59, group = "Session")
i_sessEndHour      = input.int(14,  "Session End Hour",     minval = 0, maxval = 23, group = "Session")
i_sessEndMinute    = input.int(0,   "Session End Minute",   minval = 0, maxval = 59, group = "Session")
i_closeEOD         = input.bool(true,  "Close All at Session End", group = "Session")
i_eodStartHour     = input.int(15,  "EOD Start Hour",       minval = 0, maxval = 23, group = "Session")
i_eodStartMinute   = input.int(55,  "EOD Start Minute",     minval = 0, maxval = 59, group = "Session")
i_eodEndHour       = input.int(16,  "EOD End Hour",         minval = 0, maxval = 23, group = "Session")
i_eodEndMinute     = input.int(0,   "EOD End Minute",       minval = 0, maxval = 59, group = "Session")

// --- Trade Limits ---
i_useMaxTrades   = input.bool(true,  "Limit Trades Per Day", group = "Trade Limits")
i_maxTrades      = input.int(1,      "Max Trades Per Day",   minval = 1, maxval = 20, group = "Trade Limits")
i_useDailyLoss   = input.bool(true,  "Use Daily Loss Limit", group = "Trade Limits")
i_dailyLossPct   = input.float(2.0,  "Max Daily Loss %",     minval = 0.5, maxval = 10.0, step = 0.5, group = "Trade Limits")
i_useCooldown    = input.bool(true,  "Use Cooldown After SL",  group = "Trade Limits")
i_cooldownBars   = input.int(6,      "Cooldown Bars After SL", minval = 1, maxval = 30, group = "Trade Limits")

// --- HTF Filter ---
i_useHTF       = input.bool(true,  "Use 60m HTF Trend Filter",  group = "HTF Filter")
i_htfTF        = input.timeframe("60", "Higher Timeframe",      group = "HTF Filter")
i_htfEmaLen    = input.int(21,     "HTF EMA Length",             minval = 5, maxval = 100, group = "HTF Filter")

// --- Drawdown Management ---
i_useEquityCurve  = input.bool(true,  "Reduce Size in Drawdown", group = "Risk")
i_ddThreshold     = input.float(8.0,  "Drawdown Threshold %", minval = 2, maxval = 20, step = 1, group = "Risk")
i_ddReduction     = input.float(50,   "Size Reduction %",     minval = 10, maxval = 90, step = 10, group = "Risk")

// --- Display ---
i_showDebug      = input.bool(true, "Show Debug Panel", group = "Display")
i_showBacktester = input.bool(true, "Show Backtester Panel", group = "Display")

// ============================================================================
// SECTION 2 -- INDICATORS (minimal, fast)
// ============================================================================

emaFast  = ta.ema(close, i_emaFastLen)
emaSlow  = ta.ema(close, i_emaSlowLen)

emaBullish = emaFast > emaSlow
emaBearish = emaFast < emaSlow

vwapValue = ta.vwap(hlc3)
aboveVwap = close > vwapValue
belowVwap = close < vwapValue

rsiValue = ta.rsi(close, i_rsiLen)

volSma      = ta.sma(volume, i_volLen)
volAboveAvg = volume >= volSma * i_volMultiple

atrValue = ta.atr(i_atrLen)

htfEma = i_useHTF ? request.security(syminfo.tickerid, i_htfTF, ta.ema(close, i_htfEmaLen),
         lookahead = barmerge.lookahead_off) : emaSlow
htfBullish = close > htfEma
htfBearish = close < htfEma

// ============================================================================
// SECTION 3 -- PULLBACK DETECTION (deep pullback to SLOW EMA with strong bounce)
// ============================================================================

// Trend must be established: EMA(9) clearly above EMA(21)
emaSpread     = emaFast - emaSlow
emaSpreadPct  = emaSlow > 0 ? emaSpread / emaSlow * 100 : 0
trendStrong   = math.abs(emaSpreadPct) > 0.03

// Minimum volatility: ATR must be > 0.3% of price (avoid dead chop)
atrPct       = close > 0 ? atrValue / close * 100 : 0
volEnough    = atrPct > 0.3

// Did price CLOSE below SLOW EMA in the lookback window? (deeper than just low touching)
longPullbackOccurred = false
for i = 1 to i_pullbackBars
    if close[i] <= emaSlow[i]
        longPullbackOccurred := true

shortPullbackOccurred = false
for i = 1 to i_pullbackBars
    if close[i] >= emaSlow[i]
        shortPullbackOccurred := true

// Strong bounce: close above fast EMA, bullish body > 60% of range, range > 0.5 ATR
candleRange  = high - low
candleBody   = math.abs(close - open)
bodyRatio    = candleRange > 0 ? candleBody / candleRange : 0
rangeVsATR   = atrValue > 0 ? candleRange / atrValue : 0

longBounce  = close > emaFast and close > open and bodyRatio > 0.6 and rangeVsATR > 0.5
shortBounce = close < emaFast and close < open and bodyRatio > 0.6 and rangeVsATR > 0.5

// RSI momentum: must be in favorable zone
rsiBiasLong  = rsiValue > 45 and rsiValue < i_rsiOB
rsiBiasShort = rsiValue < 55 and rsiValue > i_rsiOS

// Pullback trigger: deep pullback + strong bounce + strong trend + enough volatility
pullbackLong  = emaBullish and trendStrong and volEnough and longPullbackOccurred and longBounce and rsiBiasLong
pullbackShort = emaBearish and trendStrong and volEnough and shortPullbackOccurred and shortBounce and rsiBiasShort

// ============================================================================
// SECTION 4 -- FILTERS (kept minimal and fast)
// ============================================================================

// VWAP alignment
vwapOkLong  = not i_useVwap or aboveVwap
vwapOkShort = not i_useVwap or belowVwap

// HTF alignment
htfOkLong  = not i_useHTF or htfBullish
htfOkShort = not i_useHTF or htfBearish

// RSI not extreme
rsiOkLong  = rsiValue < i_rsiOB
rsiOkShort = rsiValue > i_rsiOS

// Volume
volumeOk = not i_useVolFilter or volAboveAvg

// ============================================================================
// SECTION 5 -- SESSION & RISK GATES
// ============================================================================

nyHour      = hour(time, i_sessionTZ)
nyMinute    = minute(time, i_sessionTZ)
nyDay       = dayofweek(time, i_sessionTZ)
nyMinuteDay = nyHour * 60 + nyMinute
isWeekday   = nyDay >= dayofweek.monday and nyDay <= dayofweek.friday

sessionStartMin = i_sessStartHour * 60 + i_sessStartMinute
sessionEndMin   = i_sessEndHour * 60 + i_sessEndMinute
eodStartMin     = i_eodStartHour * 60 + i_eodStartMinute
eodEndMin       = i_eodEndHour * 60 + i_eodEndMinute

inSession     = not i_useSession or (isWeekday and nyMinuteDay >= sessionStartMin and nyMinuteDay < sessionEndMin)
inCloseWindow = i_closeEOD and isWeekday and nyMinuteDay >= eodStartMin and nyMinuteDay < eodEndMin

var int dailyTradeCount = 0
newDay = ta.change(time("D")) != 0
if newDay
    dailyTradeCount := 0
tradesAllowed = not i_useMaxTrades or dailyTradeCount < i_maxTrades

var float dayStartEquity = strategy.initial_capital
if newDay
    dayStartEquity := strategy.equity
dailyPnL    = strategy.equity - dayStartEquity
dailyPnLPct = dayStartEquity > 0 ? (dailyPnL / dayStartEquity) * 100 : 0.0
dailyLossOk = not i_useDailyLoss or dailyPnLPct > -i_dailyLossPct

var int lastSLBar = 0
wasLoss = strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
if wasLoss and strategy.position_size == 0 and strategy.closedtrades > strategy.closedtrades[1]
    lastSLBar := bar_index
cooldownOk = not i_useCooldown or (bar_index - lastSLBar) >= i_cooldownBars

var float peakEquity = strategy.initial_capital
if strategy.equity > peakEquity
    peakEquity := strategy.equity
equityDD = peakEquity > 0 ? (peakEquity - strategy.equity) / peakEquity * 100 : 0.0
inDrawdown = i_useEquityCurve and equityDD > i_ddThreshold
sizeMult = inDrawdown ? (100.0 - i_ddReduction) / 100.0 : 1.0

var int lastTradeBar = 0
spacingOk = (bar_index - lastTradeBar) >= i_minBarsBetween

// ============================================================================
// SECTION 6 -- ENTRY CONDITIONS
// ============================================================================

longCondition = i_enableLong
     and barstate.isconfirmed
     and inSession
     and tradesAllowed
     and dailyLossOk
     and cooldownOk
     and spacingOk
     and pullbackLong
     and vwapOkLong
     and htfOkLong
     and rsiOkLong
     and volumeOk
     and strategy.position_size <= 0

shortCondition = i_enableShort
     and barstate.isconfirmed
     and inSession
     and tradesAllowed
     and dailyLossOk
     and cooldownOk
     and spacingOk
     and pullbackShort
     and vwapOkShort
     and htfOkShort
     and rsiOkShort
     and volumeOk
     and strategy.position_size >= 0

// ============================================================================
// SECTION 7 -- POSITION SIZING (with hard dollar cap)
// ============================================================================

calcQty() =>
    float rawDollar = 0.0
    if i_qtyMode == "Fixed Dollar"
        rawDollar := i_fixedDollar
    else
        riskDollars = strategy.equity * (i_riskPct / 100)
        slDist      = i_slAtrMul * atrValue
        rawDollar := slDist > 0 ? riskDollars / slDist * close : 0.0
    // Apply drawdown reduction and hard cap
    cappedDollar = math.min(rawDollar * sizeMult, i_maxQtyDollar)
    cappedDollar > 0 ? cappedDollar / close : 0.0

qtyFinal     = calcQty()
canSizeTrade = qtyFinal > 0

// ============================================================================
// SECTION 8 -- TRADE EXECUTION (simple: SL + TP + trailing, no partial)
// ============================================================================

var float entryPrice = na
var int   entryBar   = na
var float entryATR   = na

if longCondition and canSizeTrade
    entryPrice := close
    entryBar   := bar_index
    entryATR   := atrValue
    lastTradeBar := bar_index
    dailyTradeCount += 1

    sl = close - i_slAtrMul * atrValue
    tp = close + i_tpAtrMul * atrValue

    strategy.entry("Long", strategy.long, qty = qtyFinal, comment = "L")

    trailPts    = i_useTrail ? i_trailAtrMul * atrValue / syminfo.mintick : na
    trailActPts = i_useTrail ? i_trailActMul * atrValue / syminfo.mintick : na

    strategy.exit("Long Exit", from_entry = "Long",
         stop = sl, limit = tp,
         trail_points = trailActPts, trail_offset = trailPts,
         comment_loss = "L-SL", comment_profit = "L-TP")

if shortCondition and canSizeTrade
    entryPrice := close
    entryBar   := bar_index
    entryATR   := atrValue
    lastTradeBar := bar_index
    dailyTradeCount += 1

    sl = close + i_slAtrMul * atrValue
    tp = close - i_tpAtrMul * atrValue

    strategy.entry("Short", strategy.short, qty = qtyFinal, comment = "S")

    trailPts    = i_useTrail ? i_trailAtrMul * atrValue / syminfo.mintick : na
    trailActPts = i_useTrail ? i_trailActMul * atrValue / syminfo.mintick : na

    strategy.exit("Short Exit", from_entry = "Short",
         stop = sl, limit = tp,
         trail_points = trailActPts, trail_offset = trailPts,
         comment_loss = "S-SL", comment_profit = "S-TP")

// Sync entry price with actual fill
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entryPrice := strategy.position_avg_price
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    entryPrice := strategy.position_avg_price

// Stale trade exit
if i_useStaleExit and strategy.position_size != 0 and not na(entryBar) and not na(entryATR)
    barsHeld = bar_index - entryBar
    if barsHeld >= i_staleBars
        unrealizedMove = math.abs(close - entryPrice)
        if unrealizedMove < 0.5 * entryATR
            strategy.close_all(comment = "Stale")

// EOD close
if inCloseWindow and strategy.position_size != 0
    strategy.close_all(comment = "EOD")

// Reset
if strategy.position_size == 0
    entryPrice := na
    entryBar   := na
    entryATR   := na

// ============================================================================
// SECTION 9 -- DEBUG STATUS
// ============================================================================

longBlocker = not inSession ? "OUT_SESSION" :
     not tradesAllowed ? "MAX_TRADES" :
     not dailyLossOk ? "DAILY_LOSS" :
     not cooldownOk ? "COOLDOWN" :
     not spacingOk ? "SPACING" :
     not pullbackLong ? "NO_PULLBACK" :
     not vwapOkLong ? "BELOW_VWAP" :
     not htfOkLong ? "HTF_BEAR" :
     not rsiOkLong ? "RSI_OB" :
     not volumeOk ? "LOW_VOL" :
     not canSizeTrade ? "SIZE_ZERO" :
     strategy.position_size > 0 ? "LONG_OPEN" :
     strategy.position_size < 0 ? "SHORT_OPEN" : "READY"

shortBlocker = not inSession ? "OUT_SESSION" :
     not tradesAllowed ? "MAX_TRADES" :
     not dailyLossOk ? "DAILY_LOSS" :
     not cooldownOk ? "COOLDOWN" :
     not spacingOk ? "SPACING" :
     not pullbackShort ? "NO_PULLBACK" :
     not vwapOkShort ? "ABOVE_VWAP" :
     not htfOkShort ? "HTF_BULL" :
     not rsiOkShort ? "RSI_OS" :
     not volumeOk ? "LOW_VOL" :
     not canSizeTrade ? "SIZE_ZERO" :
     strategy.position_size < 0 ? "SHORT_OPEN" :
     strategy.position_size > 0 ? "LONG_OPEN" : "READY"

lbColor = longBlocker == "READY" ? color.lime : str.contains(longBlocker, "PULLBACK") ? color.orange : color.red
sbColor = shortBlocker == "READY" ? color.lime : str.contains(shortBlocker, "PULLBACK") ? color.orange : color.red

// ============================================================================
// SECTION 10 -- BACKTESTER METRICS
// ============================================================================

var float maxEquitySeen   = strategy.initial_capital
var float maxDrawdownSeen = 0.0
if strategy.equity > maxEquitySeen
    maxEquitySeen := strategy.equity
currentDrawdownPct = maxEquitySeen > 0 ? (maxEquitySeen - strategy.equity) / maxEquitySeen * 100 : 0.0
if currentDrawdownPct > maxDrawdownSeen
    maxDrawdownSeen := currentDrawdownPct

var float dayCloseEquityPrev = na
var float dayCloseEquityCurr = na
var float dailyRetSum        = 0.0
var float dailyRetSqSum      = 0.0
var float dailyDownSqSum     = 0.0
var int   dailyRetCount      = 0

if barstate.isfirst
    dayCloseEquityPrev := strategy.initial_capital
    dayCloseEquityCurr := strategy.initial_capital

if barstate.isconfirmed
    dayCloseEquityCurr := strategy.equity

if newDay and not na(dayCloseEquityPrev) and not na(dayCloseEquityCurr) and dayCloseEquityPrev > 0
    dayRet = (dayCloseEquityCurr / dayCloseEquityPrev) - 1.0
    dailyRetSum    += dayRet
    dailyRetSqSum  += math.pow(dayRet, 2)
    dailyDownSqSum += dayRet < 0 ? math.pow(dayRet, 2) : 0.0
    dailyRetCount  += 1
    dayCloseEquityPrev := dayCloseEquityCurr

dailyMeanRet = dailyRetCount > 0 ? dailyRetSum / dailyRetCount : na
dailyVarRet  = dailyRetCount > 1 ? math.max(dailyRetSqSum / dailyRetCount - math.pow(dailyMeanRet, 2), 0.0) : na
dailyStdRet  = dailyRetCount > 1 ? math.sqrt(dailyVarRet) : na
dailyDownDev = dailyRetCount > 0 ? math.sqrt(dailyDownSqSum / dailyRetCount) : na

sharpeApprox  = dailyRetCount > 1 and dailyStdRet > 0 ? (dailyMeanRet / dailyStdRet) * math.sqrt(252) : na
sortinoApprox = dailyRetCount > 0 and dailyDownDev > 0 ? (dailyMeanRet / dailyDownDev) * math.sqrt(252) : na

var int startTs = na
if barstate.isfirst
    startTs := time
elapsedYears = not na(startTs) and time > startTs ? (time - startTs) / 31557600000.0 : na
cagrApprox   = not na(elapsedYears) and elapsedYears > 0 and strategy.initial_capital > 0 and strategy.equity > 0 ? (math.pow(strategy.equity / strategy.initial_capital, 1 / elapsedYears) - 1) * 100 : na

// ============================================================================
// SECTION 11 -- VISUALS
// ============================================================================

plot(emaFast,  "EMA Fast",  color.new(color.blue, 30),   1)
plot(emaSlow,  "EMA Slow",  color.new(color.orange, 30), 1)
plot(i_useVwap ? vwapValue : na, "VWAP", color.new(color.purple, 20), 2, plot.style_stepline)
plot(i_useHTF ? htfEma : na,     "HTF EMA", color.new(color.yellow, 40), 2, plot.style_cross)

plotshape(longCondition and canSizeTrade,  "Long",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(shortCondition and canSizeTrade, "Short", shape.triangledown, location.abovebar, color.new(color.red, 0),   size = size.small)

bgcolor(inSession ? color.new(color.blue, 97) : color.new(color.gray, 98), title = "Session")
bgcolor(inCloseWindow ? color.new(color.red, 90) : na, title = "EOD")
bgcolor(not dailyLossOk ? color.new(color.red, 85) : na, title = "Loss Limit")
barcolor(longCondition and canSizeTrade ? color.lime : shortCondition and canSizeTrade ? color.fuchsia : na)

// ============================================================================
// SECTION 12 -- DASHBOARD
// ============================================================================

totalTrades = strategy.closedtrades
wins = strategy.wintrades
winRate = totalTrades > 0 ? (wins / totalTrades) * 100 : 0.0
pf = strategy.grossloss != 0 ? math.abs(strategy.grossprofit / strategy.grossloss) : 0.0

trendStr = emaBullish and aboveVwap ? "BULL" : emaBearish and belowVwap ? "BEAR" : "MIXED"
trendColor = trendStr == "BULL" ? color.green : trendStr == "BEAR" ? color.red : color.gray

var table dash = table.new(position.top_right, 2, 16,
                 bgcolor = color.new(color.black, 20),
                 border_width = 1, border_color = color.gray,
                 frame_width = 2, frame_color = color.white)

if barstate.isconfirmed
    table.cell(dash, 0, 0,  "Metric",       text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0,  "Value",        text_color = color.white,  text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 1,  "Trend",        text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1,  trendStr,        text_color = trendColor,   text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 2,  "RSI",          text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2,  str.tostring(rsiValue, "#.#"), text_color = rsiValue > i_rsiOB ? color.red : rsiValue < i_rsiOS ? color.green : color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 3,  "Daily Trades", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3,  str.tostring(dailyTradeCount) + "/" + str.tostring(i_maxTrades), text_color = dailyTradeCount >= i_maxTrades ? color.red : color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 4,  "Daily P&L",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4,  str.tostring(dailyPnLPct, "#.##") + "%", text_color = dailyPnLPct > 0 ? color.green : dailyPnLPct > -i_dailyLossPct ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 5,  "Win Rate",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5,  str.tostring(winRate, "#.#") + "% (" + str.tostring(totalTrades) + ")", text_color = winRate >= 50 ? color.green : winRate >= 40 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 6,  "Profit Factor", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6,  str.tostring(pf, "#.##"), text_color = pf > 1.5 ? color.green : pf > 1.0 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 7,  "Trade Count",  text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7,  str.tostring(totalTrades), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 8,  "Max DD",       text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 8,  str.tostring(maxDrawdownSeen, "#.##") + "%", text_color = maxDrawdownSeen > 10 ? color.red : maxDrawdownSeen > 5 ? color.orange : color.green, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 9,  "Sharpe",       text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9,  na(sharpeApprox) ? "n/a" : str.tostring(sharpeApprox, "#.##"), text_color = na(sharpeApprox) ? color.gray : sharpeApprox >= 1 ? color.green : sharpeApprox >= 0 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 10, "Sortino",      text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 10, na(sortinoApprox) ? "n/a" : str.tostring(sortinoApprox, "#.##"), text_color = na(sortinoApprox) ? color.gray : sortinoApprox >= 1.5 ? color.green : sortinoApprox >= 0 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 11, "CAGR",         text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 11, na(cagrApprox) ? "n/a" : str.tostring(cagrApprox, "#.##") + "%", text_color = na(cagrApprox) ? color.gray : cagrApprox >= 0 ? color.green : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 12, "Pos Size $",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 12, "$" + str.tostring(qtyFinal * close, "#"), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 13, "Commission %", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    commPct = strategy.grossprofit > 0 ? (strategy.closedtrades > 0 ? strategy.grossprofit : 0) : 0
    table.cell(dash, 1, 13, str.tostring(0.05 * 2, "#.##") + "% RT", text_color = color.orange, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 14, "Equity DD%",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 14, str.tostring(equityDD, "#.##") + "%", text_color = equityDD > 10 ? color.red : equityDD > 5 ? color.orange : color.green, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 15, "Position",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 15, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color = strategy.position_size == 0 ? color.white : strategy.position_size > 0 ? color.green : color.red, text_size = size.small, text_halign = text.align_right)

// --- Debug Panel ---
var table dbg = table.new(position.bottom_right, 2, 8,
                 bgcolor = color.new(color.black, 20),
                 border_width = 1, border_color = color.gray,
                 frame_width = 2, frame_color = color.silver)

if barstate.isconfirmed and i_showDebug
    table.cell(dbg, 0, 0, "Debug",       text_color = color.white,  text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 1, "Long Gate",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 1, longBlocker,    text_color = lbColor, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 2, "Short Gate",  text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 2, shortBlocker,   text_color = sbColor, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 3, "EMA Trend",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 3, emaBullish ? "BULL" : emaBearish ? "BEAR" : "FLAT", text_color = emaBullish ? color.green : emaBearish ? color.red : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 4, "HTF 60m",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 4, htfBullish ? "BULL" : htfBearish ? "BEAR" : "FLAT", text_color = htfBullish ? color.green : htfBearish ? color.red : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 5, "VWAP",        text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 5, aboveVwap ? "ABOVE" : "BELOW", text_color = aboveVwap ? color.green : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 6, "PB Long",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 6, pullbackLong ? "YES" : "NO", text_color = pullbackLong ? color.green : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(dbg, 0, 7, "PB Short",    text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dbg, 1, 7, pullbackShort ? "YES" : "NO", text_color = pullbackShort ? color.green : color.gray, text_size = size.small, text_halign = text.align_right)

// --- Backtester Panel ---
var table bt = table.new(position.bottom_left, 2, 8,
                 bgcolor = color.new(color.black, 20),
                 border_width = 1, border_color = color.gray,
                 frame_width = 2, frame_color = color.white)

if barstate.isconfirmed and i_showBacktester
    table.cell(bt, 0, 0, "Backtester", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 0, syminfo.ticker + " " + timeframe.period, text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 1, "Trade Count", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 1, str.tostring(totalTrades), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 2, "Win Rate", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 2, str.tostring(winRate, "#.#") + "%", text_color = winRate >= 50 ? color.green : winRate >= 40 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 3, "Max DD", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 3, str.tostring(maxDrawdownSeen, "#.##") + "%", text_color = maxDrawdownSeen > 10 ? color.red : maxDrawdownSeen > 5 ? color.orange : color.green, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 4, "Profit Factor", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 4, str.tostring(pf, "#.##"), text_color = pf > 1.5 ? color.green : pf > 1.0 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 5, "Sharpe", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 5, na(sharpeApprox) ? "n/a" : str.tostring(sharpeApprox, "#.##"), text_color = na(sharpeApprox) ? color.gray : sharpeApprox >= 1 ? color.green : sharpeApprox >= 0 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 6, "Sortino", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 6, na(sortinoApprox) ? "n/a" : str.tostring(sortinoApprox, "#.##"), text_color = na(sortinoApprox) ? color.gray : sortinoApprox >= 1.5 ? color.green : sortinoApprox >= 0 ? color.orange : color.red, text_size = size.small, text_halign = text.align_right)
    table.cell(bt, 0, 7, "CAGR", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(bt, 1, 7, na(cagrApprox) ? "n/a" : str.tostring(cagrApprox, "#.##") + "%", text_color = na(cagrApprox) ? color.gray : cagrApprox >= 0 ? color.green : color.red, text_size = size.small, text_halign = text.align_right)

// ============================================================================
// SECTION 13 -- ALERTS
// ============================================================================

if longCondition and canSizeTrade
    alert("v10 PB: LONG | " + syminfo.ticker + " @ " + str.tostring(close) + " | RSI: " + str.tostring(rsiValue, "#.#"), alert.freq_once_per_bar_close)

if shortCondition and canSizeTrade
    alert("v10 PB: SHORT | " + syminfo.ticker + " @ " + str.tostring(close) + " | RSI: " + str.tostring(rsiValue, "#.#"), alert.freq_once_per_bar_close)

if inCloseWindow and strategy.position_size != 0
    alert("v10 PB: EOD Close | " + syminfo.ticker, alert.freq_once_per_bar_close)
