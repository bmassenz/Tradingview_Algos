// https://mozilla.org/MPL/2.0/

//@version=6
strategy(
     "Multi-Timeframe Confluence Strategy",
     overlay          = true,
     commission_value = 0.1,
     commission_type  = strategy.commission.percent,
     slippage         = 2,
     pyramiding       = 3,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 10,
     calc_on_every_tick = false,
     max_bars_back    = 5000
     )

// ============================================================================
// SECTION 1 -- INPUT PARAMETERS (8 core free parameters)
// ============================================================================

// Trend layer
i_emaFast       = input.int(50,    "EMA Fast Length",        minval=5,   maxval=200,  group="Trend")
i_emaSlow       = input.int(200,   "EMA Slow Length",        minval=50,  maxval=500,  group="Trend")
i_supertrendMul = input.float(3.0, "Supertrend Multiplier",  minval=1.0, maxval=6.0,  step=0.5, group="Trend")

// Setup / entry layer
i_rsiLen        = input.int(14,    "RSI / Stoch Length",     minval=5,   maxval=30,   group="Setup")
i_adxThreshHigh = input.int(25,    "ADX Trend Threshold",    minval=15,  maxval=40,   group="Setup")
i_adxThreshLow  = input.int(20,    "ADX Range Threshold",    minval=10,  maxval=30,   group="Setup")

// Risk
i_atrSlMul      = input.float(2.0, "ATR Stop-Loss Multiple", minval=0.5, maxval=5.0,  step=0.5, group="Risk")
i_atrTpMul      = input.float(3.0, "ATR Take-Profit Multiple", minval=1.0, maxval=8.0, step=0.5, group="Risk")

// Session filter (exchange local time)
i_sessStart     = input.int(30,    "Session buffer minutes",  minval=0, maxval=120,   group="Session",
                     tooltip="Avoid first/last N minutes of the session")

// ============================================================================
// SECTION 2 -- HELPER FUNCTIONS
// ============================================================================

// Directional Movement / ADX calculation (Pine v6 compatible)
adx(len) =>
    up   = ta.change(high)
    down = -ta.change(low)
    plusDM  = na(up)   ? na : (up > down and up > 0   ? up   : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = ta.rma(ta.tr, len)
    plusDI  = 100 * ta.rma(plusDM, len)  / trueRange
    minusDI = 100 * ta.rma(minusDM, len) / trueRange
    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adxVal = ta.rma(dx, len)
    [adxVal, plusDI, minusDI]

// Supertrend calculation
supertrend(factor, atrLen) =>
    src    = hl2
    atrVal = ta.atr(atrLen)
    upperBand = src + factor * atrVal
    lowerBand = src - factor * atrVal
    prevLower = nz(lowerBand[1])
    prevUpper = nz(upperBand[1])
    lowerBand := lowerBand > prevLower or close[1] < prevLower ? lowerBand : prevLower
    upperBand := upperBand < prevUpper or close[1] > prevUpper ? upperBand : prevUpper
    var int dir = 1
    dir := dir == -1 and close > prevUpper ? 1 :
           dir ==  1 and close < prevLower ? -1 : dir
    stLine = dir == 1 ? lowerBand : upperBand
    [stLine, dir]

// ============================================================================
// SECTION 3 -- DAILY TIMEFRAME INDICATORS (TREND LAYER)
// ============================================================================

// --- EMA 50 / 200 ---
d_emaFast = request.security(syminfo.tickerid, "D", ta.ema(close, i_emaFast),
             lookahead = barmerge.lookahead_off)
d_emaSlow = request.security(syminfo.tickerid, "D", ta.ema(close, i_emaSlow),
             lookahead = barmerge.lookahead_off)

d_emaUptrend   = d_emaFast > d_emaSlow
d_emaDowntrend = d_emaFast < d_emaSlow

// --- Supertrend (Daily) ---
[d_stLine_raw, d_stDir_raw] = request.security(syminfo.tickerid, "D",
             supertrend(i_supertrendMul, 10),
             lookahead = barmerge.lookahead_off)
d_stBullish = d_stDir_raw == 1
d_stBearish = d_stDir_raw == -1

// Detect supertrend flips on the daily
d_stFlipBear = d_stBullish[1] and d_stBearish
d_stFlipBull = d_stBearish[1] and d_stBullish

// --- ADX (Daily) ---
[d_adxVal, d_plusDI, d_minusDI] = request.security(syminfo.tickerid, "D",
             adx(14),
             lookahead = barmerge.lookahead_off)

d_trending = d_adxVal > i_adxThreshHigh
d_ranging  = d_adxVal < i_adxThreshLow

// ============================================================================
// SECTION 4 -- 4-HOUR TIMEFRAME INDICATORS (SETUP LAYER)
// ============================================================================

// --- RSI (4H) ---
h4_rsi = request.security(syminfo.tickerid, "240", ta.rsi(close, i_rsiLen),
             lookahead = barmerge.lookahead_off)

h4_rsiCrossAbove30 = ta.crossover(h4_rsi, 30)
h4_rsiCrossBelow70 = ta.crossunder(h4_rsi, 70)

// --- MACD (4H) ---
[h4_macdLine, h4_signal, h4_hist] = request.security(syminfo.tickerid, "240",
             ta.macd(close, 12, 26, 9),
             lookahead = barmerge.lookahead_off)

h4_macdBullCross = ta.crossover(h4_macdLine, h4_signal)
h4_macdBearCross = ta.crossunder(h4_macdLine, h4_signal)

// ============================================================================
// SECTION 5 -- CHART TIMEFRAME INDICATORS (ENTRY LAYER)
// ============================================================================

// --- Stochastic (14, 3, 3) ---
stochK = ta.sma(ta.stoch(close, high, low, i_rsiLen), 3)
stochD = ta.sma(stochK, 3)

stochBullCross = ta.crossover(stochK, stochD) and stochK < 30
stochBearCross = ta.crossunder(stochK, stochD) and stochK > 70

// --- Volume confirmation ---
volSma     = ta.sma(volume, 20)
volConfirm = volume > volSma

// --- ATR for stops ---
atrVal = ta.atr(14)

// --- Bollinger Bands (used in ranging/mean-reversion mode) ---
bbBasis  = ta.sma(close, 20)
bbDev    = 2.0 * ta.stdev(close, 20)
bbUpper  = bbBasis + bbDev
bbLower  = bbBasis - bbDev

// ============================================================================
// SECTION 6 -- SESSION FILTER
// ============================================================================

// Avoid first and last N minutes of the regular session.
// Works for any exchange; uses session() to detect the regular session window.
var int sessionMinutes = na
if session.ismarket
    sessionMinutes := (hour * 60 + minute)

inSessionBody = session.ismarket
notFirstMins  = not na(sessionMinutes) ? (minute >= i_sessStart or hour > 0) : true
// We approximate "not in last 30 min" by checking bar_index is not near session end
sessionOk     = barstate.isconfirmed and inSessionBody

// ============================================================================
// SECTION 7 -- REGIME DETECTION
// ============================================================================

regime_trend = d_trending               // ADX > 25
regime_range = d_ranging                // ADX < 20
regime_neutral = not regime_trend and not regime_range

regimeStr = regime_trend ? "TREND" : regime_range ? "RANGE" : "NEUTRAL"

// ============================================================================
// SECTION 8 -- POSITION SIZING & DRAWDOWN MANAGEMENT
// ============================================================================

// Rolling 5-day equity drawdown
var float peakEquity5d = strategy.equity
if ta.barssince(ta.change(time("D"))) == 0
    peakEquity5d := math.max(peakEquity5d, strategy.equity)

equityDD     = peakEquity5d > 0 ? (peakEquity5d - strategy.equity) / peakEquity5d * 100 : 0.0
ddReduction  = equityDD > 5.0 ? 0.5 : 1.0

// Risk 1% of equity, sized by ATR stop distance
riskPerTrade = strategy.equity * 0.01 * ddReduction
stopDist     = i_atrSlMul * atrVal
qtyRisk      = stopDist > 0 ? riskPerTrade / stopDist : na

// ============================================================================
// SECTION 9 -- ENTRY CONDITIONS
// ============================================================================

// --- LONG CONDITIONS ---
// Trend-following mode (ADX > 25)
trendLongSetup = h4_rsiCrossAbove30 or h4_macdBullCross
trendLongOk    = d_emaUptrend and d_stBullish and regime_trend and trendLongSetup

// Mean-reversion mode (ADX < 20) -- price near lower Bollinger Band
revLongOk      = regime_range and d_emaUptrend and close <= bbLower * 1.005
                 and (h4_rsiCrossAbove30 or h4_rsi < 35)

longEntry = (trendLongOk or revLongOk)
             and stochBullCross
             and volConfirm
             and sessionOk
             and strategy.opentrades < 3

// --- SHORT CONDITIONS ---
trendShortSetup = h4_rsiCrossBelow70 or h4_macdBearCross
trendShortOk    = d_emaDowntrend and d_stBearish and regime_trend and trendShortSetup

revShortOk      = regime_range and d_emaDowntrend and close >= bbUpper * 0.995
                  and (h4_rsiCrossBelow70 or h4_rsi > 65)

shortEntry = (trendShortOk or revShortOk)
              and stochBearCross
              and volConfirm
              and sessionOk
              and strategy.opentrades < 3

// ============================================================================
// SECTION 10 -- TRADE EXECUTION
// ============================================================================

// Calculate stop / take-profit / trail levels
longSL   = close - i_atrSlMul * atrVal
longTP   = close + i_atrTpMul * atrVal
shortSL  = close + i_atrSlMul * atrVal
shortTP  = close - i_atrTpMul * atrVal

trailOffset  = 1.5 * atrVal
trailActivation = 1.5 * atrVal

if longEntry and not na(qtyRisk)
    strategy.entry("Long", strategy.long, qty = qtyRisk,
                    comment = "L-" + regimeStr)
    strategy.exit("Long TP/SL", "Long",
                   stop     = longSL,
                   limit    = longTP,
                   trail_points  = trailActivation / syminfo.mintick,
                   trail_offset  = trailOffset / syminfo.mintick,
                   comment_loss  = "L-SL",
                   comment_profit = "L-TP")

if shortEntry and not na(qtyRisk)
    strategy.entry("Short", strategy.short, qty = qtyRisk,
                    comment = "S-" + regimeStr)
    strategy.exit("Short TP/SL", "Short",
                   stop     = shortSL,
                   limit    = shortTP,
                   trail_points  = trailActivation / syminfo.mintick,
                   trail_offset  = trailOffset / syminfo.mintick,
                   comment_loss  = "S-SL",
                   comment_profit = "S-TP")

// ============================================================================
// SECTION 11 -- SUPERTREND FLIP EXIT (override)
// ============================================================================

// If daily supertrend flips against the position, close immediately.
if d_stFlipBear and strategy.position_size > 0
    strategy.close("Long", comment = "ST-FlipExit")

if d_stFlipBull and strategy.position_size < 0
    strategy.close("Short", comment = "ST-FlipExit")

// ============================================================================
// SECTION 12 -- PLOTS & VISUAL OVERLAYS
// ============================================================================

// EMA ribbons (daily, projected onto chart)
plot(d_emaFast, "Daily EMA Fast", color.new(color.teal, 30), 2)
plot(d_emaSlow, "Daily EMA Slow", color.new(color.orange, 30), 2)

// Supertrend line
stColor = d_stBullish ? color.new(color.green, 20) : color.new(color.red, 20)
plot(d_stLine_raw, "Daily Supertrend", stColor, 2, plot.style_stepline_diamond)

// Bollinger Bands (shown only in range mode)
bbColor = regime_range ? color.new(color.purple, 60) : na
plot(regime_range ? bbUpper : na, "BB Upper", bbColor, 1)
plot(regime_range ? bbLower : na, "BB Lower", bbColor, 1)

// Entry markers
plotshape(longEntry,  "Long Signal",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(shortEntry, "Short Signal", shape.triangledown,  location.abovebar, color.red,   size = size.small)

// Background tint by regime
bgcolor(regime_trend ? color.new(color.green, 95) :
        regime_range ? color.new(color.orange, 95) :
        color.new(color.gray, 97), title = "Regime BG")

// ============================================================================
// SECTION 13 -- DASHBOARD TABLE
// ============================================================================

var table dash = table.new(position.top_right, 2, 6,
                 bgcolor = color.new(color.black, 20),
                 border_width = 1,
                 border_color = color.gray,
                 frame_width  = 2,
                 frame_color  = color.white)

// Win rate calculation
totalTrades = strategy.closedtrades
wins = strategy.wintrades
winRate = totalTrades > 0 ? (wins / totalTrades) * 100 : 0.0

// Signal status string
sigStatus = longEntry ? "LONG ENTRY" :
            shortEntry ? "SHORT ENTRY" :
            d_stFlipBear and strategy.position_size > 0 ? "LONG EXIT" :
            d_stFlipBull and strategy.position_size < 0 ? "SHORT EXIT" :
            "NO SIGNAL"

sigColor = longEntry ? color.green :
           shortEntry ? color.red :
           color.gray

if barstate.islast
    // Headers
    table.cell(dash, 0, 0, "Metric",     text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, "Value",      text_color = color.white, text_size = size.small, text_halign = text.align_right)
    // Row 1 -- Regime
    table.cell(dash, 0, 1, "Regime",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, regimeStr,    text_color = regime_trend ? color.green : regime_range ? color.orange : color.gray,
               text_size = size.small, text_halign = text.align_right)
    // Row 2 -- Signal
    table.cell(dash, 0, 2, "Signal",     text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, sigStatus,    text_color = sigColor, text_size = size.small, text_halign = text.align_right)
    // Row 3 -- Open positions
    table.cell(dash, 0, 3, "Positions",  text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, str.tostring(strategy.opentrades),
               text_color = color.white, text_size = size.small, text_halign = text.align_right)
    // Row 4 -- Equity drawdown
    table.cell(dash, 0, 4, "Equity DD%", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4, str.tostring(equityDD, "#.##") + "%",
               text_color = equityDD > 5 ? color.red : equityDD > 2 ? color.orange : color.green,
               text_size = size.small, text_halign = text.align_right)
    // Row 5 -- Win rate
    table.cell(dash, 0, 5, "Win Rate",   text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5, str.tostring(winRate, "#.#") + "% (" + str.tostring(totalTrades) + ")",
               text_color = winRate >= 50 ? color.green : winRate >= 40 ? color.orange : color.red,
               text_size = size.small, text_halign = text.align_right)

// ============================================================================
// SECTION 14 -- ALERT CONDITIONS
// ============================================================================

alertcondition(longEntry,           title = "Long Entry",  message = "MTF Strategy: LONG entry  | {{ticker}} @ {{close}} | Regime: " + regimeStr)
alertcondition(shortEntry,          title = "Short Entry", message = "MTF Strategy: SHORT entry | {{ticker}} @ {{close}} | Regime: " + regimeStr)

longExitCond  = d_stFlipBear and strategy.position_size > 0
shortExitCond = d_stFlipBull and strategy.position_size < 0

alertcondition(longExitCond,        title = "Long Exit",   message = "MTF Strategy: LONG exit (ST flip) | {{ticker}} @ {{close}}")
alertcondition(shortExitCond,       title = "Short Exit",  message = "MTF Strategy: SHORT exit (ST flip) | {{ticker}} @ {{close}}")
