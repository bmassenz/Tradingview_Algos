# Copy to .env next to this file. Never commit .env.
WEBHOOK_SECRET=change-me-to-a-long-random-string          # openssl rand -hex 32
TASTYTRADE_PROVIDER_SECRET=                               # OAuth application secret (tastytrade: My Profile > API > OAuth applications)
TASTYTRADE_REFRESH_TOKEN=                                  # personal grant refresh token for the sandbox (cert) environment
TASTYTRADE_ACCOUNT_NUMBER=                                 # your sandbox (certification) account number
TASTYTRADE_SANDBOX_MODE=true                               # must stay true; the service refuses to start otherwise
DRY_RUN=true                                               # true: validate orders only. false: submit to the sandbox.
ALLOWED_SYMBOLS=SPY,QQQ,SMH
MAX_QTY_PER_ORDER=500
JOURNAL_PATH=journal.jsonl
PORT=8000
