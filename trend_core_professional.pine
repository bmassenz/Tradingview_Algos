// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// at https://mozilla.org/MPL/2.0/
//
// Trend-Core Professional (Core only)
// Long-only trend core: the Core position of "Trend-Core WAE Professional" with the WAE overlay removed.
// Research/backtest model for liquid US equity ETFs (validated on SPY, QQQ, SMH, IWM daily).
//
// Why Core only (2026-09-25): a side-by-side run in TradingView's Strategy Tester and in the Python
// replica (rl_optimizer/tv_verify/RESULTS.md) showed the three-tier overlay contributed 1% to 3% of
// profit on every ETF over 2008-2026 while carrying most of the script's complexity. Removing it
// leaves Sharpe and drawdown unchanged. Core rules, defaults, execution settings and alert payloads
// are identical to the full script, so the Core trades match it exactly.
//
// Execution model:
// - Signals are evaluated on confirmed bar closes only; orders fill at the NEXT bar's open.
//   (process_orders_on_close is OFF: a signal computed from a close cannot also trade at that close.)
// - The protective trailing stop is submitted together with the entry, so it is live from the fill bar.
// - Chart data is split-adjusted by TradingView. Dividends are not included (conservative for ETFs).
// Chart: daily. Load bars from 2006 or earlier so the trend EMA is warm by 2008.
//
// IMPORTANT:
// - This is a systematic research strategy, not investment advice.
// - For live automation, use broker-native protective orders and broker-authoritative reconciliation.

//@version=6
strategy(
     "Trend-Core Professional",
     overlay = true,
     pyramiding = 1,
     initial_capital = 26000,
     currency = currency.USD,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.01,
     slippage = 2,
     process_orders_on_close = false,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     use_bar_magnifier = false,
     margin_long = 50,
     close_entries_rule = "ANY",
     fill_orders_on_standard_ohlc = true
)

// ============================================================================
// Inputs
// ============================================================================
string grpCore   = "1. Core Trend Position"
string grpRisk   = "2. Sizing"
string grpVisual = "3. Visuals"

startDate = input.time(
     timestamp("2008-01-01T00:00:00"), "Trade From",
     group = grpCore,
     tooltip = "No new positions before this date. Earlier bars only warm up indicators."
)

coreAllocationPct = input.float(
     100.0, "Core Allocation % of Equity",
     minval = 10.0, maxval = 150.0, step = 5.0, group = grpCore,
     tooltip = "100% is unlevered equity exposure. Values above 100% require margin and increase drawdown risk."
)

emaLen = input.int(
     251, "EMA Trend Length",
     minval = 20, maxval = 500, step = 5, group = grpCore
)

coreTrailPct = input.float(
     15.25, "Core Trailing Stop %",
     minval = 1.0, maxval = 30.0, step = 0.25, group = grpCore,
     tooltip = "Trailing stop from the highest high since entry. A gap through the stop fills at the open, which can be worse than this percentage."
)

coreReentryCooldown = input.int(
     12, "Core Re-entry Cooldown (bars)",
     minval = 0, maxval = 60, group = grpCore,
     tooltip = "Bars to wait after any Core exit before a new Core entry. Reduces stop-out / re-entry whipsaw."
)

paperSizingCapital = input.float(
     26000.0, "Paper / Sizing Capital $",
     minval = 1000.0, step = 500.0, group = grpRisk,
     tooltip = "Account size used for the Core qty when fixed paper sizing is ON."
)

useFixedPaperSizing = input.bool(
     true, "Use Fixed Paper Sizing Capital",
     group = grpRisk,
     tooltip = "ON: size from Paper/Sizing Capital $, not strategy.equity growth. OFF: use strategy.equity (compounding)."
)

qtyIncrement = input.float(
     1.0, "Quantity Increment",
     minval = 0.000001, step = 0.000001, group = grpRisk,
     tooltip = "Use 1 for whole-share trading. Set the broker-supported fractional increment only when applicable."
)

showEMA = input.bool(true, "Plot EMA", group = grpVisual)
showStops = input.bool(true, "Plot Trailing Stop", group = grpVisual)
showSignals = input.bool(true, "Plot Entry Markers", group = grpVisual)
showStatusTable = input.bool(true, "Show Status Table", group = grpVisual)

// ============================================================================
// Utility functions
// ============================================================================
f_roundDownToIncrement(float value, float increment) =>
    increment > 0.0 ? math.floor(value / increment) * increment : na

f_sizingEquity() =>
    useFixedPaperSizing ? paperSizingCapital : strategy.equity

f_hasOpenTrade(string entryId) =>
    bool found = false
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            found := found or strategy.opentrades.entry_id(i) == entryId
    found

f_openTradePrice(string entryId) =>
    float price = na
    if strategy.opentrades > 0
        for i = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(i) == entryId
                price := strategy.opentrades.entry_price(i)
    price

// ============================================================================
// Trend calculation
// ============================================================================
float pointValue = math.max(syminfo.pointvalue, 0.00000001)
float emaValue = ta.ema(close, emaLen)
bool coreTrendOK = close > emaValue
bool confirmedBar = barstate.isconfirmed
bool inDateRange = time >= startDate

// ============================================================================
// Core state and protective trailing stop
// ============================================================================
bool coreOpen = f_hasOpenTrade("Core")

var bool coreOrderPending = false
var int coreOrderBar = na
var int coreEntryBar = na
var int coreCooldownUntil = na
var float corePeak = na
var float coreStop = na

string coreStopAlert = "{\"event\":\"core_stop\",\"symbol\":\"{{ticker}}\",\"id\":\"{{strategy.order.id}}\",\"action\":\"{{strategy.order.action}}\",\"qty\":\"{{strategy.order.contracts}}\",\"fill_price\":\"{{strategy.order.price}}\"}"

if coreOpen
    coreOrderPending := false
    // Peak starts at the fill; the fill bar's high occurs after the opening fill.
    if not coreOpen[1]
        coreEntryBar := bar_index
        corePeak := math.max(f_openTradePrice("Core"), high)
    else
        corePeak := math.max(nz(corePeak, high), high)
    coreStop := corePeak * (1.0 - coreTrailPct / 100.0)
    strategy.exit("CoreProtectiveStop", from_entry = "Core", stop = coreStop, comment = "Core Trailing Stop", alert_message = coreStopAlert)
    if confirmedBar and not coreTrendOK
        strategy.close(
             "Core",
             comment = "Core EMA Exit",
             alert_message = "{\"event\":\"core_ema_exit\",\"symbol\":\"{{ticker}}\",\"id\":\"{{strategy.order.id}}\",\"action\":\"{{strategy.order.action}}\",\"qty\":\"{{strategy.order.contracts}}\",\"fill_price\":\"{{strategy.order.price}}\"}"
        )
else
    if coreOpen[1]
        coreCooldownUntil := bar_index + coreReentryCooldown
    if coreOrderPending and bar_index > nz(coreOrderBar, bar_index)
        coreOrderPending := false
    if not coreOrderPending
        corePeak := na
        coreStop := na
        coreEntryBar := na

bool coreCooldownOK = na(coreCooldownUntil) or bar_index >= coreCooldownUntil

// Enter the core only after confirmed trend qualification. Fills at the next open.
if confirmedBar and inDateRange and coreTrendOK and not coreOpen and not coreOrderPending and coreCooldownOK
    float sizingEq = f_sizingEquity()
    float rawCoreQty = (sizingEq * coreAllocationPct / 100.0) / (close * pointValue)
    float coreQty = f_roundDownToIncrement(rawCoreQty, qtyIncrement)
    if coreQty >= qtyIncrement
        strategy.entry(
             "Core",
             strategy.long,
             qty = coreQty,
             comment = "Core Trend Entry",
             alert_message = "{\"event\":\"core_entry\",\"symbol\":\"{{ticker}}\",\"id\":\"{{strategy.order.id}}\",\"action\":\"{{strategy.order.action}}\",\"qty\":\"{{strategy.order.contracts}}\",\"fill_price\":\"{{strategy.order.price}}\"}"
        )
        // Bracket submitted with the entry so the fill bar is protected.
        strategy.exit("CoreProtectiveStop", from_entry = "Core", stop = close * (1.0 - coreTrailPct / 100.0), comment = "Core Trailing Stop", alert_message = coreStopAlert)
        coreOrderPending := true
        coreOrderBar := bar_index

// ============================================================================
// Visuals
// ============================================================================
plot(showEMA ? emaValue : na, "Trend EMA", color = color.orange, linewidth = 2)
plot(showStops and coreOpen ? coreStop : na, "Core Protective Stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plotshape(showSignals and confirmedBar and inDateRange and coreTrendOK and not coreOpen and not coreOrderPending and coreCooldownOK, title = "Core Long Signal", text = "CORE", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny)

var table statusTable = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast and showStatusTable
    table.cell(statusTable, 0, 0, "Trend-Core", text_color = color.white, bgcolor = color.rgb(30, 30, 30))
    table.cell(statusTable, 1, 0, "Status", text_color = color.white, bgcolor = color.rgb(30, 30, 30))
    table.cell(statusTable, 0, 1, "Core trend")
    table.cell(statusTable, 1, 1, coreTrendOK ? "UP" : "OUT", text_color = coreTrendOK ? color.lime : color.red)
    table.cell(statusTable, 0, 2, "Core open")
    table.cell(statusTable, 1, 2, coreOpen ? "YES" : "NO", text_color = coreOpen ? color.lime : color.silver)
    table.cell(statusTable, 0, 3, "Trailing stop")
    table.cell(statusTable, 1, 3, coreOpen ? str.tostring(coreStop, format.mintick) : "-", text_color = color.silver)
    table.cell(statusTable, 0, 4, "Cooldown")
    table.cell(statusTable, 1, 4, coreCooldownOK ? "CLEAR" : "WAIT", text_color = coreCooldownOK ? color.lime : color.red)
